# Copy to .env and fill in. NEVER commit the real .env (see CLAUDE.md section 14).

# --- Database ---------------------------------------------------------------
# Used by the FastAPI backend and the ingestion scripts.
POSTGRES_USER=german
POSTGRES_PASSWORD=german
POSTGRES_DB=german
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy URL. Inside docker-compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgresql+psycopg://german:german@localhost:5432/german

# --- Anthropic API (agent + MCP server #1 semantic grading) ----------------
# Not needed for backend/core or backend/learner_model tests.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- MCP servers ----------------------------------------------------------
# Server #1 (learning tools) and server #2 (secondary surface) run as
# genuinely separate processes (non-negotiable principle #5).
LEARNING_MCP_HOST=0.0.0.0
LEARNING_MCP_PORT=8100
SECONDARY_MCP_HOST=0.0.0.0
SECONDARY_MCP_PORT=8101
# Which secondary server to run: "calendar" or "notes" (CLAUDE.md section 10).
SECONDARY_MCP_KIND=notes
# For the notes server: where weekly progress summaries are written.
NOTES_VAULT_DIR=./_vault

# --- TTS (optional; pronunciation generated on demand, CLAUDE.md section 6) -
TTS_API_KEY=
TTS_PROVIDER=

# --- Tracing -------------------------------------------------------------
# Structured JSON logging is always on. Langfuse is optional (section 3).
TRACE_LOG_PATH=./_traces/trace.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
