# Copy this to /opt/learn-german/.env on the droplet and fill in real values.
# This file is read by `docker compose -f docker-compose.prod.yml --env-file .env`.
# It is NEVER overwritten by the CD pipeline.

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=german
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_string
POSTGRES_DB=german

# --- App --------------------------------------------------------------------
# Haiku keeps the live demo cheap; override if you want a stronger grader.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# The SPA is served same-origin, so "*" is harmless here; tighten if you like.
CORS_ALLOW_ORIGINS=*

# --- Web address / TLS ------------------------------------------------------
#   :80                      plain HTTP on the droplet IP (start here)
#   159.223.226.180.nip.io   free HTTPS, no domain to buy
#   deutsch.example.com      your real domain (add the A record first)
SITE_ADDRESS=:80

# --- Optional -------------------------------------------------------------
# The CD pipeline sets IMAGE to the exact commit it built. Leaving it unset
# here just means a manual `docker compose ... up` uses :latest.
# IMAGE=ghcr.io/nabeelahmad123/deutsch-ai:latest
